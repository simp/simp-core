#authselect --enableshadow --passalgo=sha512
network --nodns --hostname=puppet.change.me
# No root password: use the 'simp' user and sudo. Set one after install if needed.
rootpw --lock
# No fixed GRUB password: %post asks for one at the console.
bootloader --location=mbr --append="fips=1" --driveorder=sda,hda
firewall --enabled --ssh
firstboot --disable
logging --level=info
timezone --utc GMT

zerombr
clearpart --all
reboot

%include /tmp/part-include
%include /tmp/repo-include

