# Shell code for the chroot %post in auto.cfg and min.cfg, pulled in with
# %include. It expects stdin/stdout/stderr on /dev/tty6 (the console the
# 'simp' password prompt just used), and runs in bash.

# The ISO ships no GRUB password either, so ask for one now. GRUB needs it to
# edit a boot entry, not to boot one. Write it where 'bootloader --password'
# would: user.cfg, next to each grub.cfg that loads it (/boot/grub2 on BIOS,
# /boot/efi/EFI/<vendor> on UEFI).
grub_dirs=()
for grub_cfg in /boot/grub2/grub.cfg /boot/efi/EFI/*/grub.cfg; do
  if grep -q '^### BEGIN /etc/grub.d/01_users ###$' "$grub_cfg" 2>/dev/null; then
    grub_dirs+=("${grub_cfg%/*}")
  fi
done
grub_hash=''
if [ "${#grub_dirs[@]}" -gt 0 ]; then
  echo
  echo "Set the GRUB password (15+ characters). It is needed to edit boot entries, not to boot."
  until [ -n "$grub_hash" ]; do
    # A failed read means no usable console: stop asking and warn below.
    IFS= read -rs -p 'GRUB password: ' grub_pw || break; echo
    IFS= read -rs -p 'Retype GRUB password: ' grub_pw2 || break; echo
    if [ "${#grub_pw}" -lt 15 ]; then
      echo "The password must be at least 15 characters. Try again."
    elif [ "$grub_pw" != "$grub_pw2" ]; then
      echo "The passwords do not match. Try again."
    else
      grub_hash=$(printf '%s\n%s\n' "$grub_pw" "$grub_pw" | grub2-mkpasswd-pbkdf2 | sed -n 's/^.*PBKDF2 hash of your password is //p')
      [ -n "$grub_hash" ] || break
    fi
  done
  unset grub_pw grub_pw2
fi
if [ -n "$grub_hash" ]; then
  for grub_dir in "${grub_dirs[@]}"; do
    install -m 0600 /dev/null "${grub_dir}/user.cfg"
    echo "GRUB2_PASSWORD=${grub_hash}" > "${grub_dir}/user.cfg"
  done
  unset grub_hash
else
  echo "WARNING: the GRUB password was NOT set."
  echo "Run grub2-setpassword after the install finishes."
  read -r -p 'Press Enter to continue. '
fi
